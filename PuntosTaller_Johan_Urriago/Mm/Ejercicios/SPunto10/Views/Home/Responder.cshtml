@model Encuesta
@{ ViewData["Title"] = "Responder encuesta"; }

<h1>@Model.Pregunta</h1>
<form method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    @for (int i = 0; i < Model.Opciones.Count; i++)
    {
        <div class="form-check">
            <input class="form-check-input" type="radio" name="opcion" value="@i" id="o@(i)" required />
            <label class="form-check-label" for="o@(i)">@Model.Opciones[i]</label>
        </div>
    }
    <button class="btn btn-primary mt-3">Votar</button>
    <a asp-action="Index" class="btn btn-link mt-3">Volver</a>
</form>
