@model IReadOnlyList<Reserva>
@{
    ViewData["Title"] = "Sistema de Reservas";
    string servicio = ViewBag.Servicio;
    DateTime fecha = ViewBag.Fecha;
    var disponibles = (List<string>)ViewBag.Disponibles;
}

<h1>Sistema de Reservas</h1>
@if (ViewBag.Mensaje != null) { <div class="alert alert-info">@ViewBag.Mensaje</div> }

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <select name="servicio" class="form-select">
            @foreach (var s in SistemaReservas.Servicios) { <option selected="@(s == servicio)">@s</option> }
        </select>
    </div>
    <div class="col-md-4"><input type="date" name="fecha" value="@fecha.ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" /></div>
    <div class="col-md-3"><button class="btn btn-secondary w-100">Ver disponibilidad</button></div>
</form>

<h5>Horarios para @servicio el @fecha.ToString("dd/MM/yyyy")</h5>
<div class="mb-3">
@foreach (var h in SistemaReservas.Horas)
{
    var libre = disponibles.Contains(h);
    <span class="badge @(libre ? "bg-success" : "bg-secondary") me-1">@h @(libre ? "" : "(ocupado)")</span>
}
</div>

<form asp-action="Reservar" method="post" class="row g-2 mb-4">
    <input type="hidden" name="Servicio" value="@servicio" />
    <input type="hidden" name="Fecha" value="@fecha.ToString("yyyy-MM-dd")" />
    <div class="col-md-5"><input name="Cliente" class="form-control" placeholder="Tu nombre" required /></div>
    <div class="col-md-4">
        <select name="Hora" class="form-select" required>
            @foreach (var h in disponibles) { <option>@h</option> }
        </select>
    </div>
    <div class="col-md-3"><button class="btn btn-primary w-100" disabled="@(!disponibles.Any())">Confirmar reserva</button></div>
</form>

<h5>Reservas confirmadas</h5>
<table class="table">
    <thead><tr><th>Cliente</th><th>Servicio</th><th>Fecha</th><th>Hora</th><th></th></tr></thead>
    <tbody>
    @foreach (var r in Model)
    {
        <tr><td>@r.Cliente</td><td>@r.Servicio</td><td>@r.Fecha.ToString("dd/MM/yyyy")</td><td>@r.Hora</td>
            <td><form asp-action="Cancelar" method="post"><input type="hidden" name="id" value="@r.Id" /><button class="btn btn-sm btn-danger">Cancelar</button></form></td></tr>
    }
    </tbody>
</table>
