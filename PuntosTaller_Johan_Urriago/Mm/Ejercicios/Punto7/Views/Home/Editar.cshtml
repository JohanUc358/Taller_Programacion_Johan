@model Evento
@{ ViewData["Title"] = "Editar evento"; }

<h1>Editar evento</h1>
<form asp-action="Guardar" method="post" class="row g-2">
    <input type="hidden" name="Id" value="@Model.Id" />
    <div class="col-md-4"><input name="Titulo" value="@Model.Titulo" class="form-control" required /></div>
    <div class="col-md-3"><input name="Inicio" type="datetime-local" value="@Model.Inicio.ToString("yyyy-MM-ddTHH:mm")" class="form-control" required /></div>
    <div class="col-md-3">
        <select name="RecordatorioMin" class="form-select">
            @foreach (var (v, t) in new[] { (0, "Sin recordatorio"), (5, "5 min antes"), (15, "15 min antes"), (60, "1 hora antes") })
            { <option value="@v" selected="@(v == Model.RecordatorioMin)">@t</option> }
        </select>
    </div>
    <div class="col-md-2"><button class="btn btn-primary w-100">Guardar</button></div>
</form>
<form asp-action="Eliminar" method="post" class="mt-3">
    <input type="hidden" name="id" value="@Model.Id" />
    <button class="btn btn-danger">Eliminar evento</button>
    <a asp-action="Index" class="btn btn-link">Volver</a>
</form>
